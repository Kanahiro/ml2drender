{
  "name": "@ml2drender/wasm",
  "version": "0.4.3",
  "description": "MapLibre style 2D renderer in pure Rust / WebAssembly, no GPU",
  "license": "BSD-3-Clause",
  "repository": { "type": "git", "url": "git+https://github.com/Kanahiro/ml2drender.git", "directory": "packages/ml2drender" },
  "homepage": "https://kanahiro.github.io/ml2drender/",
  "type": "module",
  "engines": { "node": "^22.23.4 || ^24.22.1 || >=26.12.1" },
  "exports": {
    ".": "./src/index.ts",
    "./renderer.wasm": {
      "types": "./src/wasm.d.ts",
      "default": "./wasm/ml2drender_wasm.wasm"
    }
  },
  "publishConfig": {
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./renderer.wasm": {
        "types": "./src/wasm.d.ts",
        "default": "./wasm/ml2drender_wasm.wasm"
      }
    }
  },
  "files": ["dist", "src/wasm.d.ts", "wasm"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node tests/single-flight.ts && node tests/shared-instance.ts && node tests/projected-view.ts && node tests/unsupported-layers.ts",
    "docs": "typedoc"
  },
  "peerDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.4.4"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "26.4.4",
    "typedoc": "0.28.20",
    "typescript": "6.0.3"
  }
}
