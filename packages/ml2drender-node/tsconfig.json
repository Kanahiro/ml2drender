{
  "compilerOptions": {
    "strict": true,
    "erasableSyntaxOnly": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests"]
}
