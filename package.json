{
  "name": "ml2drender-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "fixtures": "sh scripts/fetch-fixtures.sh",
    "build": "cargo build --release",
    "build:wasm": "cargo build -p ml2drender-wasm --target wasm32-unknown-unknown --profile wasm && mkdir -p packages/ml2drender/wasm && cp target/wasm32-unknown-unknown/wasm/ml2drender_wasm.wasm packages/ml2drender/wasm/",
    "test": "cargo test --release",
    "test:render": "cargo run --release -p ml2drender-cli -- render-tests",
    "test:expression": "node packages/ml2drender/tests/expression-tests.ts",
    "bench": "node scripts/bench.ts",
    "demo": "pnpm build:wasm && pnpm --filter demo-browser dev",
    "typecheck": "pnpm -r typecheck"
  }
}
